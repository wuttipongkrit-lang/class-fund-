<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ระบบเงินกองกลาง 68)</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Google Fonts: Prompt -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Prompt:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <!-- Lucide Icons CDN -->
    <script src="https://unpkg.com/lucide@latest"></script>
    <!-- QRCode.js CDN -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>

    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Prompt', 'sans-serif'],
                    },
                    colors: {
                        mint: {
                            50: '#f0fdf4',
                            100: '#dcfce7',
                            200: '#bbf7d0',
                            500: '#10b981',
                            600: '#059669',
                            700: '#047857',
                        }
                    }
                }
            }
        }
    </script>
    <style>
        body {
            font-family: 'Prompt', sans-serif;
            background-color: #f8fafc;
        }
        ::-webkit-scrollbar {
            width: 6px;
            height: 6px;
        }
        ::-webkit-scrollbar-track {
            background: #f1f5f9;
        }
        ::-webkit-scrollbar-thumb {
            background: #cbd5e1;
            border-radius: 4px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: #94a3b8;
        }
        .animate-fade-in {
            animation: fadeIn 0.25s ease-in-out;
        }
        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(4px); }
            to { opacity: 1; transform: translateY(0); }
        }
    </style>
</head>
<body class="text-slate-800 min-h-screen flex flex-col pb-12 select-none">

    <!-- Header / Navbar -->
    <header class="bg-white/90 backdrop-blur-md border-b border-slate-200 sticky top-0 z-30">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex justify-between items-center h-16">
                <div class="flex items-center space-x-3">
                    <div class="w-10 h-10 rounded-2xl bg-teal-500 text-white flex items-center justify-center shadow-md shadow-teal-500/20">
                        <i data-lucide="wallet" class="w-5 h-5"></i>
                    </div>
                    <div>
                        <h1 class="text-base sm:text-lg font-bold text-slate-900 leading-tight">
                            ระบบเงินกองกลาง
                        </h1>
                        <p class="text-xs text-slate-500 font-medium" id="headerGroupName">ม.6/1 (ปีการศึกษา 2569)</p>
                    </div>
                </div>

                <div class="flex items-center space-x-2">
                    <button onclick="openLineModal()" class="inline-flex items-center space-x-1.5 px-3 py-2 sm:px-4 sm:py-2 bg-emerald-500 hover:bg-emerald-600 text-white text-xs sm:text-sm font-medium rounded-xl shadow-sm transition-all transform active:scale-95">
                        <i data-lucide="share-2" class="w-4 h-4"></i>
                        <span class="hidden sm:inline">คัดลอกสรุปส่ง</span><span>LINE</span>
                    </button>
                    <button onclick="openSettingsOrUserModal()" class="p-2 text-slate-600 hover:text-slate-900 hover:bg-slate-100 rounded-xl transition-all" title="ตั้งค่า / สลับบัญชีผู้ใช้">
                        <i data-lucide="settings" class="w-5 h-5"></i>
                    </button>
                    <button onclick="logout()" class="p-2 text-rose-500 hover:text-rose-700 hover:bg-rose-50 rounded-xl transition-all" title="ออกจากระบบ">
                        <i data-lucide="log-out" class="w-5 h-5"></i>
                    </button>
                </div>
            </div>
        </div>
    </header>

    <!-- Student Auth Status Bar -->
    <div id="currentUserBar" class="bg-slate-900 text-white text-xs py-2 px-4 border-b border-slate-800">
        <div class="max-w-7xl mx-auto flex justify-between items-center">
            <div class="flex items-center space-x-2">
                <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
                <span>เข้าสู่ระบบในฐานะ: <strong id="loggedInUserText" class="text-emerald-400 font-semibold">กำลังโหลด...</strong></span>
                <span id="loggedInRoleBadge" class="ml-2 px-2 py-0.5 rounded text-[10px] bg-slate-800 text-slate-300 font-medium border border-slate-700">นักศึกษา</span>
            </div>
            <button onclick="showLoginModal()" class="underline hover:text-emerald-300 text-[11px]">สลับผู้ใช้งาน / เข้าสู่ระบบใหม่</button>
        </div>
    </div>

    <!-- Personal Student Alert Banner -->
    <div id="studentPersonalCard" class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-4 hidden">
        <div id="studentAlertBg" class="p-4 rounded-2xl border flex flex-col sm:flex-row items-center justify-between gap-3 shadow-sm">
            <div class="flex items-center space-x-3">
                <div id="studentAlertIcon" class="w-10 h-10 rounded-xl flex items-center justify-center font-bold text-white flex-shrink-0">
                    <i data-lucide="user-check" class="w-5 h-5"></i>
                </div>
                <div>
                    <h4 class="text-sm font-bold text-slate-900" id="studentAlertTitle">สถานะการชำระเงินของคุณ</h4>
                    <p class="text-xs text-slate-600" id="studentAlertDetail">ยอดค้างชำระประจำเดือน: ฿100.00 บาท</p>
                </div>
            </div>
            <div id="studentActionArea"></div>
        </div>
    </div>

    <!-- Main Dashboard Container -->
    <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-6 flex-grow w-full">

        <!-- 4 Overview Cards -->
        <section class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 mb-6">
            
            <!-- Card 1: Current Balance -->
            <div class="bg-slate-900 text-white rounded-2xl p-5 shadow-lg relative overflow-hidden flex flex-col justify-between border border-slate-800">
                <div class="absolute -right-3 -bottom-3 opacity-10 text-white pointer-events-none">
                    <i data-lucide="scale" class="w-28 h-28"></i>
                </div>
                <div class="flex items-center justify-between mb-2 z-10">
                    <span class="text-xs font-medium text-slate-300">ยอดเงินคงเหลือปัจจุบัน</span>
                    <span class="p-1.5 bg-slate-800 text-emerald-400 rounded-lg border border-slate-700">
                        <i data-lucide="scale" class="w-4 h-4"></i>
                    </span>
                </div>
                <div class="z-10 my-1">
                    <div class="text-2xl sm:text-3xl font-extrabold tracking-tight text-emerald-400" id="dashBalance">฿50.00</div>
                </div>
                <div class="text-[11px] text-slate-400 flex items-center z-10 mt-1">
                    <i data-lucide="check-circle-2" class="w-3.5 h-3.5 mr-1 text-emerald-400"></i>
                    <span>คำนวณจาก (ยอดเก็บ - รายจ่าย)</span>
                </div>
            </div>

            <!-- Card 2: Total Revenue -->
            <div class="bg-white rounded-2xl p-5 border border-slate-200/80 shadow-sm relative hover:shadow-md transition-shadow flex flex-col justify-between">
                <div class="flex items-center justify-between mb-2">
                    <span class="text-xs font-medium text-slate-500">ยอดเก็บเงินได้ทั้งหมด</span>
                    <span class="p-1.5 bg-emerald-50 text-emerald-600 rounded-lg">
                        <i data-lucide="arrow-down-left" class="w-4 h-4"></i>
                    </span>
                </div>
                <div class="my-1">
                    <div class="text-2xl sm:text-3xl font-bold text-slate-900" id="dashTotalPaid">฿600</div>
                </div>
                <div class="text-xs text-slate-500 flex items-center justify-between mt-1">
                    <span>ชำระแล้ว <strong class="text-slate-800" id="dashPaidCount">6</strong> คน</span>
                    <span id="dashPaidPercentage" class="font-bold text-emerald-600">60%</span>
                </div>
            </div>

            <!-- Card 3: Total Expenses -->
            <div class="bg-white rounded-2xl p-5 border border-slate-200/80 shadow-sm relative hover:shadow-md transition-shadow flex flex-col justify-between">
                <div class="flex items-center justify-between mb-2">
                    <span class="text-xs font-medium text-slate-500">ยอดรายจ่ายทั้งหมด</span>
                    <span class="p-1.5 bg-rose-50 text-rose-500 rounded-lg">
                        <i data-lucide="arrow-up-right" class="w-4 h-4"></i>
                    </span>
                </div>
                <div class="my-1">
                    <div class="text-2xl sm:text-3xl font-bold text-slate-900" id="dashTotalExpense">฿550.00</div>
                </div>
                <div class="text-xs text-slate-500 flex items-center mt-1">
                    <i data-lucide="receipt" class="w-3.5 h-3.5 mr-1 text-slate-400"></i>
                    <span>รวมบันทึก <strong class="text-slate-800" id="dashExpenseCount">2</strong> รายการ</span>
                </div>
            </div>

            <!-- Card 4: Fund Goal -->
            <div class="bg-white rounded-2xl p-5 border border-slate-200/80 shadow-sm relative hover:shadow-md transition-shadow flex flex-col justify-between">
                <div>
                    <div class="flex items-center justify-between mb-2">
                        <span class="text-xs font-medium text-slate-500">เป้าหมายเงินกองกลาง</span>
                        <span class="p-1.5 bg-teal-50 text-teal-600 rounded-lg">
                            <i data-lucide="target" class="w-4 h-4"></i>
                        </span>
                    </div>
                    <div class="flex items-baseline justify-between">
                        <span class="text-xl font-bold text-slate-900" id="dashTargetCollected">฿600</span>
                        <span class="text-xs text-slate-500">เป้า <span id="dashTargetGoal">฿1,000</span></span>
                    </div>
                    <div class="w-full bg-slate-100 rounded-full h-2 overflow-hidden my-2">
                        <div id="dashProgressBar" class="bg-emerald-500 h-2 rounded-full transition-all duration-500" style="width: 60%"></div>
                    </div>
                </div>
                <div class="text-[11px] text-slate-500 flex justify-between items-center mt-1">
                    <span>ค้างชำระ: <strong class="text-slate-800" id="dashPendingCount">3</strong> คน</span>
                    <span class="text-rose-500 font-medium" id="dashOverdueCount">1 ค้างชำระ</span>
                </div>
            </div>

        </section>

        <!-- Navigation Tabs -->
        <div class="flex space-x-1 border-b border-slate-200 mb-6 bg-slate-100/70 p-1 rounded-2xl">
            <button onclick="switchTab('members')" id="tabBtnMembers" class="flex-1 py-2.5 px-4 text-xs sm:text-sm font-medium rounded-xl transition-all flex items-center justify-center space-x-2 bg-white text-slate-900 shadow-sm">
                <i data-lucide="users" class="w-4 h-4"></i>
                <span>ติดตามการชำระเงิน</span>
            </button>
            <button onclick="switchTab('expenses')" id="tabBtnExpenses" class="flex-1 py-2.5 px-4 text-xs sm:text-sm font-medium rounded-lg transition-all flex items-center justify-center space-x-2 text-slate-600 hover:text-slate-900">
                <i data-lucide="receipt" class="w-4 h-4"></i>
                <span>บันทึกรายจ่ายห้อง</span>
            </button>
        </div>

        <!-- TAB 1: Payment Tracker Section -->
        <section id="sectionMembers" class="animate-fade-in">
            <div class="bg-white rounded-2xl p-4 border border-slate-200/80 shadow-sm mb-4 flex flex-col md:flex-row gap-3 items-center justify-between">
                <div class="relative w-full md:w-72">
                    <i data-lucide="search" class="w-4 h-4 absolute left-3 top-1/2 -translate-y-1/2 text-slate-400"></i>
                    <input type="text" id="memberSearch" oninput="renderMembers()" placeholder="ค้นหาชื่อ หรือ เลขที่/รหัส..." class="w-full pl-9 pr-3 py-2 bg-slate-50 border border-slate-200 rounded-xl text-xs sm:text-sm focus:outline-none focus:ring-2 focus:ring-emerald-500 focus:bg-white transition-all">
                </div>

                <div class="flex items-center space-x-1 w-full md:w-auto overflow-x-auto pb-1 md:pb-0">
                    <button onclick="setMemberFilter('all')" id="filterBtnAll" class="px-3 py-1.5 text-xs font-medium rounded-lg bg-slate-900 text-white transition-all whitespace-nowrap">ทั้งหมด (<span id="countFilterAll">10</span>)</button>
                    <button onclick="setMemberFilter('paid')" id="filterBtnPaid" class="px-3 py-1.5 text-xs font-medium rounded-lg bg-slate-100 text-slate-600 hover:bg-slate-200 transition-all whitespace-nowrap">จ่ายแล้ว (<span id="countFilterPaid">6</span>)</button>
                    <button onclick="setMemberFilter('pending')" id="filterBtnPending" class="px-3 py-1.5 text-xs font-medium rounded-lg bg-slate-100 text-slate-600 hover:bg-slate-200 transition-all whitespace-nowrap">ยังไม่จ่าย (<span id="countFilterPending">3</span>)</button>
                    <button onclick="setMemberFilter('overdue')" id="filterBtnOverdue" class="px-3 py-1.5 text-xs font-medium rounded-lg bg-slate-100 text-slate-600 hover:bg-slate-200 transition-all whitespace-nowrap">ค้างชำระ (<span id="countFilterOverdue">1</span>)</button>
                </div>

                <div class="flex items-center space-x-2 w-full md:w-auto justify-end">
                    <button onclick="openPromptPayModal()" class="px-3 py-2 bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs font-medium rounded-xl transition-all flex items-center space-x-1.5">
                        <i data-lucide="qr-code" class="w-4 h-4 text-emerald-600"></i>
                        <span>QR พร้อมเปย์</span>
                    </button>
                    <button id="addMemberBtn" onclick="openAddMemberModal()" class="px-3 py-2 bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-medium rounded-xl shadow-sm transition-all flex items-center space-x-1.5">
                        <i data-lucide="user-plus" class="w-4 h-4"></i>
                        <span>เพิ่มสมาชิก</span>
                    </button>
                </div>
            </div>

            <div class="bg-white rounded-2xl border border-slate-200/80 shadow-sm overflow-hidden">
                <div class="overflow-x-auto">
                    <table class="w-full text-left border-collapse">
                        <thead>
                            <tr class="bg-slate-50/80 border-b border-slate-200 text-[11px] uppercase tracking-wider text-slate-500 font-semibold">
                                <th class="py-3 px-4 w-16 text-center">เลขที่</th>
                                <th class="py-3 px-4">ชื่อ - นามสกุล</th>
                                <th class="py-3 px-4 text-center">สถานะการชำระ</th>
                                <th class="py-3 px-4 text-right">ยอดที่ต้องจ่าย</th>
                                <th class="py-3 px-4 text-center">จัดการ / ดำเนินการ</th>
                            </tr>
                        </thead>
                        <tbody id="memberTableBody" class="divide-y divide-slate-100 text-xs sm:text-sm"></tbody>
                    </table>
                </div>
                <div id="emptyMemberState" class="hidden py-12 text-center text-slate-400">
                    <i data-lucide="users" class="w-12 h-12 mx-auto mb-2 opacity-40"></i>
                    <p class="text-sm font-medium">ไม่พบข้อมูลสมาชิกในระบบ</p>
                </div>
            </div>
        </section>

        <!-- TAB 2: Expense Records Section -->
        <section id="sectionExpenses" class="hidden animate-fade-in">
            <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-3 mb-4">
                <div>
                    <h2 class="text-base font-bold text-slate-900">บันทึกรายจ่ายเงินห้อง / สรุปบิล</h2>
                    <p class="text-xs text-slate-500">บันทึกรายการใช้จ่ายพร้อมตรวจสอบความโปร่งใสของกองกลาง</p>
                </div>
                <button id="addExpenseBtn" onclick="openAddExpenseModal()" class="px-4 py-2 bg-rose-600 hover:bg-rose-700 text-white text-xs sm:text-sm font-medium rounded-xl shadow-sm transition-all flex items-center space-x-1.5">
                    <i data-lucide="plus-circle" class="w-4 h-4"></i>
                    <span>บันทึกรายจ่ายใหม่</span>
                </button>
            </div>

            <div class="bg-white rounded-2xl border border-slate-200/80 shadow-sm overflow-hidden">
                <div id="expenseList" class="divide-y divide-slate-100"></div>
                <div id="emptyExpenseState" class="hidden py-12 text-center text-slate-400">
                    <i data-lucide="receipt" class="w-12 h-12 mx-auto mb-2 opacity-40"></i>
                    <p class="text-sm font-medium">ยังไม่มีรายการบันทึกรายจ่าย</p>
                </div>
            </div>
        </section>

    </main>

    <!-- MODAL 0: Student ID Login Modal -->
    <div id="modalLogin" class="fixed inset-0 bg-slate-900/80 backdrop-blur-md z-50 flex items-center justify-center p-4">
        <div class="bg-white rounded-3xl max-w-md w-full p-6 sm:p-8 shadow-2xl relative border border-slate-100">
            <div class="text-center mb-6">
                <div class="inline-flex items-center justify-center w-14 h-14 rounded-2xl bg-gradient-to-tr from-emerald-500 to-teal-600 text-white shadow-lg shadow-emerald-500/30 mb-3">
                    <i data-lucide="shield-check" class="w-8 h-8"></i>
                </div>
                <h2 class="text-xl font-bold text-slate-900">ยืนยันตัวตนเข้าใช้งาน</h2>
                <p class="text-xs text-slate-500 mt-1">กรอกรหัสนักศึกษา หรือ รหัสเหรัญญิก เพื่อเข้าสู่ระบบเงินกองกลาง</p>
            </div>

            <form onsubmit="handleLoginSubmit(event)" class="space-y-4">
                <div>
                    <label class="block text-xs font-semibold text-slate-700 mb-1">รหัสนักศึกษา / รหัสเหรัญญิก</label>
                    <div class="relative">
                        <i data-lucide="user" class="w-4 h-4 absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400"></i>
                        <input type="text" id="loginIdInput" required placeholder="เช่น 69001 หรือ 69000 (เหรัญญิก)" class="w-full pl-10 pr-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-sm font-medium focus:outline-none focus:ring-2 focus:ring-emerald-500 focus:bg-white transition-all">
                    </div>
                </div>

                <div id="loginErrorMsg" class="hidden text-xs text-rose-600 bg-rose-50 p-3 rounded-xl border border-rose-200 flex items-start space-x-2">
                    <i data-lucide="alert-circle" class="w-4 h-4 text-rose-500 flex-shrink-0 mt-0.5"></i>
                    <span id="loginErrorText">ไม่พบรหัสนักศึกษานี้ในระบบ กรุณาติดต่อเหรัญญิก</span>
                </div>

                <button type="submit" class="w-full py-3 bg-emerald-600 hover:bg-emerald-700 text-white rounded-xl text-sm font-semibold shadow-md shadow-emerald-600/20 transition-all transform active:scale-95 flex items-center justify-center space-x-2">
                    <span>เข้าสู่ระบบ</span>
                    <i data-lucide="arrow-right" class="w-4 h-4"></i>
                </button>
            </form>

            <div class="mt-6 pt-4 border-t border-slate-100 text-[11px] text-slate-500">
                <p class="font-semibold text-slate-700 mb-1">💡 รหัสทดสอบสำหรับสาธิต:</p>
                <div class="grid grid-cols-2 gap-2 text-[10px] bg-slate-50 p-2.5 rounded-xl border border-slate-200 font-mono">
                    <div>• เหรัญญิก: <strong class="text-emerald-700">69000</strong></div>
                    <div>• นักศึกษา: <strong class="text-teal-700">69001 - 69010</strong></div>
                </div>
            </div>
        </div>
    </div>

    <!-- MODAL 1: PromptPay QR Modal -->
    <div id="modalPromptPay" class="fixed inset-0 bg-slate-900/60 backdrop-blur-sm z-50 flex items-center justify-center p-4 hidden animate-fade-in">
        <div class="bg-white rounded-3xl max-w-sm w-full p-6 shadow-2xl relative border border-slate-100">
            <button onclick="closeModal('modalPromptPay')" class="absolute right-4 top-4 text-slate-400 hover:text-slate-600 p-1.5 rounded-full hover:bg-slate-100">
                <i data-lucide="x" class="w-5 h-5"></i>
            </button>
            
            <div class="text-center">
                <div class="inline-flex items-center justify-center w-12 h-12 rounded-2xl bg-emerald-50 text-emerald-600 mb-2">
                    <i data-lucide="qr-code" class="w-6 h-6"></i>
                </div>
                <h3 class="text-base font-bold text-slate-900">สแกนจ่ายเงินผ่าน PromptPay</h3>
                <p class="text-xs text-slate-500">สำหรับโอนเข้าบัญชีกองกลางชั้นปี</p>
            </div>

            <div class="mt-4 p-4 bg-slate-50 rounded-2xl border border-slate-200 text-center flex flex-col items-center">
                <div id="qrcodeCanvas" class="bg-white p-3 rounded-xl shadow-sm border border-slate-200 min-h-[170px] min-w-[170px] flex items-center justify-center"></div>

                <div class="mt-3 w-full text-left space-y-1 text-xs">
                    <div class="flex justify-between items-center text-slate-600">
                        <span>ชื่อบัญชี:</span>
                        <strong class="text-slate-900 font-semibold" id="modalAccountName">นายสมชาย ใจดี</strong>
                    </div>
                    <div class="flex justify-between items-center text-slate-600">
                        <span>เลขพร้อมเปย์:</span>
                        <div class="flex items-center space-x-1">
                            <strong class="text-slate-900 font-mono" id="modalPromptPayNo">081-234-5678</strong>
                            <button onclick="copyToClipboard(appState.promptpayNo, 'คัดลอกเลขพร้อมเปย์แล้ว!')" class="text-emerald-600 hover:text-emerald-800 p-1">
                                <i data-lucide="copy" class="w-3.5 h-3.5"></i>
                            </button>
                        </div>
                    </div>
                </div>
