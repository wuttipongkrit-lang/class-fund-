    <script>
        const STORAGE_KEY = 'class_fund_app_state_v2';
        const SESSION_KEY = 'class_fund_session_v2';

        const defaultData = {
            groupName: 'ม.6/1 (ปีการศึกษา 2569)',
            promptpayNo: '0812345678',
            accountName: 'นายสมชาย ใจดี (เหรัญญิก)',
            targetGoal: 1000,
            members: [
                { id: 1, no: '01', stdId: '69001', name: 'นายกิตติศักดิ์ มีสุข', status: 'paid', amount: 100 },
                { id: 2, no: '02', stdId: '69002', name: 'นางสาวจิราพร วงศ์สว่าง', status: 'paid', amount: 100 },
                { id: 3, no: '03', stdId: '69003', name: 'นายชยพล สุวรรณโณ', status: 'pending', amount: 100 },
                { id: 4, no: '04', stdId: '69004', name: 'นางสาวณิชาภา บุญประเสริฐ', status: 'paid', amount: 100 },
                { id: 5, no: '05', stdId: '69005', name: 'นายธนกฤต เลิศพิพัฒน์', status: 'overdue', amount: 100 },
                { id: 6, no: '06', stdId: '69006', name: 'นายปัญญาวุฒิ แก้วมณี', status: 'paid', amount: 100 },
                { id: 7, no: '07', stdId: '69007', name: 'นางสาวพิมพกานต์ รัตนเดช', status: 'pending', amount: 100 },
                { id: 8, no: '08', stdId: '69008', name: 'นายวรเมธ เอกชัย', status: 'paid', amount: 100 },
                { id: 9, no: '09', stdId: '69009', name: 'นางสาวศุภิสรา ไชยวงศ์', status: 'paid', amount: 100 },
                { id: 10, no: '10', stdId: '69010', name: 'นายอานนท์ ศรีสุวรรณ', status: 'pending', amount: 100 }
            ],
            expenses: [
                { id: 1, title: 'ค่าถ่ายเอกสารชีทฟิสิกส์ประจำเดือน', category: 'สื่อ/ชีทเรียน', amount: 350, date: '2026-09-02', note: 'ชีทตะลุยโจทย์ 10 หน้า' },
                { id: 2, title: 'อุปกรณ์ทำพานไหว้ครู/ป้ายห้อง', category: 'กิจกรรม/งานกลุ่ม', amount: 200, date: '2026-09-05', note: 'ซื้อดอกไม้สดและริบบิ้น' }
            ]
        };

        let appState = loadState();
        let currentUser = loadSession();
        let currentFilter = 'all';

        function loadState() {
            try {
                const saved = localStorage.getItem(STORAGE_KEY);
                return saved ? JSON.parse(saved) : defaultData;
            } catch (e) {
                return defaultData;
            }
        }

        function saveState() {
            try {
                localStorage.setItem(STORAGE_KEY, JSON.stringify(appState));
            } catch (e) {
                console.error(e);
            }
            updateUI();
        }

        function loadSession() {
            try {
                const session = localStorage.getItem(SESSION_KEY);
                return session ? JSON.parse(session) : null;
            } catch (e) {
                return null;
            }
        }

        function saveSession(user) {
            currentUser = user;
            if (user) {
                localStorage.setItem(SESSION_KEY, JSON.stringify(user));
            } else {
                localStorage.removeItem(SESSION_KEY);
            }
        }

        function resetToDefaultData() {
            if (confirm('คุณต้องการรีเซ็ตกลับเป็นข้อมูลตัวอย่างตั้งต้นใช่หรือไม่?')) {
                appState = JSON.parse(JSON.stringify(defaultData));
                saveState();
                closeModal('modalSettings');
                showToast('รีเซ็ตข้อมูลตัวอย่างเรียบร้อยแล้ว');
            }
        }

        function crc16(data) {
            let crc = 0xFFFF;
            for (let i = 0; i < data.length; i++) {
                let x = ((crc >> 8) ^ data.charCodeAt(i)) & 0xFF;
                x ^= x >> 4;
                crc = ((crc << 8) ^ (x << 12) ^ ((x & 0xF) << 5) ^ (x >> 4)) & 0xFFFF;
            }
            return crc.toString(16).toUpperCase().padStart(4, '0');
        }

        function generatePromptPayPayload(target, amount) {
            let targetStr = target.replace(/[^0-9]/g, '');
            let targetType = targetStr.length >= 13 ? '02' : '01';
            
            if (targetType === '01') {
                if (targetStr.startsWith('0')) {
                    targetStr = '66' + targetStr.substring(1);
                }
                targetStr = targetStr.padStart(13, '0');
            }

            const tag29 = '0016A000000677010111' +
                          targetType + String(targetStr.length).padStart(2, '0') + targetStr;
            
            let payload = '000201' +
                          '010212' + 
                          '29' + String(tag29.length).padStart(2, '0') + tag29 +
                          '5303764';

            if (amount && amount > 0) {
                const amountStr = Number(amount).toFixed(2);
                payload += '54' + String(amountStr.length).padStart(2, '0') + amountStr;
            }

            payload += '5802TH' + '6304';
            const checksum = crc16(payload);
            return payload + checksum;
        }

        function handleLoginSubmit(e) {
            e.preventDefault();
            const inputVal = document.getElementById('loginIdInput').value.trim();
            const errorMsg = document.getElementById('loginErrorMsg');

            errorMsg.classList.add('hidden');

            if (inputVal === '69000' || inputVal === '1234' || inputVal.toLowerCase() === 'admin') {
                const user = { role: 'treasurer', stdId: '69000', name: 'นายสมชาย ใจดี (เหรัญญิก)' };
                saveSession(user);
                closeModal('modalLogin');
                showToast('ยินดีต้อนรับ เหรัญญิก เข้าสู่ระบบ');
                updateUI();
                return;
            }

            const foundMember = appState.members.find(m => m.stdId === inputVal || m.no === inputVal);
            if (foundMember) {
                const user = { role: 'student', stdId: foundMember.stdId, name: foundMember.name, memberId: foundMember.id };
                saveSession(user);
                closeModal('modalLogin');
                showToast(`ยินดีต้อนรับ ${foundMember.name}`);
                updateUI();
                return;
            }

            errorMsg.classList.remove('hidden');
            document.getElementById('loginErrorText').textContent = 'ไม่พบรหัสนักศึกษานี้ในระบบ กรุณาติดต่อเหรัญญิก';
        }

        function showLoginModal() {
            document.getElementById('loginIdInput').value = '';
            document.getElementById('loginErrorMsg').classList.add('hidden');
            openModal('modalLogin');
        }

        function logout() {
            saveSession(null);
            showLoginModal();
        }

        function openSettingsOrUserModal() {
            if (currentUser && currentUser.role === 'treasurer') {
                openSettingsModal();
            } else {
                showLoginModal();
            }
        }

        function updateUI() {
            if (!currentUser) {
                showLoginModal();
                return;
            }

            document.getElementById('headerGroupName').textContent = appState.groupName;
            document.getElementById('loggedInUserText').textContent = currentUser.name;
            document.getElementById('loggedInRoleBadge').textContent = currentUser.role === 'treasurer' ? 'เหรัญญิก (Admin)' : `นักศึกษา (${currentUser.stdId})`;
            
            if (currentUser.role === 'treasurer') {
                document.getElementById('loggedInRoleBadge').className = 'ml-2 px-2 py-0.5 rounded text-[10px] bg-emerald-800 text-emerald-200 font-bold border border-emerald-600';
            } else {
                document.getElementById('loggedInRoleBadge').className = 'ml-2 px-2 py-0.5 rounded text-[10px] bg-slate-800 text-slate-300 font-medium border border-slate-700';
            }

            const personalCard = document.getElementById('studentPersonalCard');
            if (currentUser.role === 'student') {
                const member = appState.members.find(m => m.id === currentUser.memberId || m.stdId === currentUser.stdId);
                if (member) {
                    personalCard.classList.remove('hidden');
                    const alertBg = document.getElementById('studentAlertBg');
                    const alertIcon = document.getElementById('studentAlertIcon');
                    const alertTitle = document.getElementById('studentAlertTitle');
                    const alertDetail = document.getElementById('studentAlertDetail');
                    const actionArea = document.getElementById('studentActionArea');

                    if (member.status === 'paid') {
                        alertBg.className = 'p-4 rounded-2xl bg-emerald-50 border border-emerald-200 flex flex-col sm:flex-row items-center justify-between gap-3 shadow-sm';
                        alertIcon.className = 'w-10 h-10 rounded-xl bg-emerald-500 text-white flex items-center justify-center font-bold flex-shrink-0';
                        alertIcon.innerHTML = `<i data-lucide="check-circle-2" class="w-6 h-6"></i>`;
                        alertTitle.textContent = 'คุณชำระเงินเรียบร้อยแล้ว';
                        alertTitle.className = 'text-sm font-bold text-emerald-900';
                        alertDetail.textContent = `ยอดชำระแล้ว: ฿${member.amount} บาท (สถานะ: จ่ายแล้วเรียบร้อย)`;
                        actionArea.innerHTML = `<span class="px-3 py-1.5 bg-emerald-100 text-emerald-800 rounded-xl font-bold text-xs">ชำระแล้วเรียบร้อย</span>`;
                    } else {
                        alertBg.className = 'p-4 rounded-2xl bg-amber-50 border border-amber-200 flex flex-col sm:flex-row items-center justify-between gap-3 shadow-sm';
                        alertIcon.className = 'w-10 h-10 rounded-xl bg-amber-500 text-white flex items-center justify-center font-bold flex-shrink-0';
                        alertIcon.innerHTML = `<i data-lucide="clock" class="w-6 h-6"></i>`;
                        alertTitle.textContent = `คุณมียอดค้างชำระ: ฿${member.amount} บาท`;
                        alertTitle.className = 'text-sm font-bold text-amber-900';
                        alertDetail.textContent = 'กรุณาสแกน QR พร้อมเปย์ เพื่อโอนเงินเข้าบัญชีกองกลาง';
                        actionArea.innerHTML = `<button onclick="openPromptPayModal(${member.amount})" class="px-4 py-2 bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-semibold rounded-xl shadow-sm transition-all flex items-center space-x-1">
                            <i data-lucide="qr-code" class="w-4 h-4"></i>
                            <span>เปิด QR โอนเงิน</span>
                        </button>`;
                    }
                }
            } else {
                personalCard.classList.add('hidden');
            }

            const addMemberBtn = document.getElementById('addMemberBtn');
            const addExpenseBtn = document.getElementById('addExpenseBtn');
            if (currentUser.role === 'treasurer') {
                addMemberBtn.classList.remove('hidden');
                addExpenseBtn.classList.remove('hidden');
            } else {
                addMemberBtn.classList.add('hidden');
                addExpenseBtn.classList.add('hidden');
            }

            const totalPaidRevenue = appState.members
                .filter(m => m.status === 'paid')
                .reduce((sum, m) => sum + (m.amount || 100), 0);

            const totalExpenses = appState.expenses
                .reduce((sum, e) => sum + Number(e.amount), 0);

            const currentBalance = totalPaidRevenue - totalExpenses;

            const targetGoal = appState.targetGoal || 1000;
            const paidCount = appState.members.filter(m => m.status === 'paid').length;
            const pendingCount = appState.members.filter(m => m.status === 'pending').length;
            const overdueCount = appState.members.filter(m => m.status === 'overdue').length;
            const paidPercentage = appState.members.length > 0 ? Math.round((paidCount / appState.members.length) * 100) : 0;

            document.getElementById('dashBalance').textContent = `฿${currentBalance.toLocaleString('th-TH', {minimumFractionDigits: 2})}`;
            document.getElementById('dashTotalPaid').textContent = `฿${totalPaidRevenue.toLocaleString('th-TH')}`;
            document.getElementById('dashPaidCount').textContent = paidCount;
            document.getElementById('dashPaidPercentage').textContent = `${paidPercentage}%`;

            document.getElementById('dashTotalExpense').textContent = `฿${totalExpenses.toLocaleString('th-TH', {minimumFractionDigits: 2})}`;
            document.getElementById('dashExpenseCount').textContent = appState.expenses.length;

            document.getElementById('dashTargetCollected').textContent = `฿${totalPaidRevenue.toLocaleString('th-TH')}`;
            document.getElementById('dashTargetGoal').textContent = `฿${targetGoal.toLocaleString('th-TH')}`;
            document.getElementById('dashProgressBar').style.width = `${Math.min(Math.round((totalPaidRevenue / targetGoal) * 100), 100)}%`;
            document.getElementById('dashPendingCount').textContent = pendingCount + overdueCount;
            document.getElementById('dashOverdueCount').textContent = `${overdueCount} ค้างชำระ`;

            document.getElementById('countFilterAll').textContent = appState.members.length;
            document.getElementById('countFilterPaid').textContent = paidCount;
            document.getElementById('countFilterPending').textContent = pendingCount;
            document.getElementById('countFilterOverdue').textContent = overdueCount;

            renderMembers();
            renderExpenses();
            lucide.createIcons();
        }

        function renderMembers() {
            const tbody = document.getElementById('memberTableBody');
            const searchVal = document.getElementById('memberSearch').value.toLowerCase().trim();
            const emptyState = document.getElementById('emptyMemberState');

            tbody.innerHTML = '';

            const filtered = appState.members.filter(m => {
                const matchesSearch = m.name.toLowerCase().includes(searchVal) || 
                                      m.no.toString().includes(searchVal) || 
                                      (m.stdId && m.stdId.toLowerCase().includes(searchVal));
                const matchesFilter = currentFilter === 'all' || m.status === currentFilter;
                return matchesSearch && matchesFilter;
            });

            if (filtered.length === 0) {
                emptyState.classList.remove('hidden');
            } else {
                emptyState.classList.add('hidden');
            }

            const isTreasurer = currentUser && currentUser.role === 'treasurer';

            filtered.sort((a, b) => a.no.localeCompare(b.no, undefined, {numeric: true})).forEach(member => {
                const tr = document.createElement('tr');
                tr.className = 'hover:bg-slate-50/80 transition-colors';

                let statusBadge = '';
                if (member.status === 'paid') {
                    statusBadge = `<span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-semibold bg-emerald-100 text-emerald-700">
                        <i data-lucide="check-circle-2" class="w-3.5 h-3.5 mr-1"></i> จ่ายแล้ว
                    </span>`;
                } else if (member.status === 'overdue') {
                    statusBadge = `<span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-semibold bg-rose-100 text-rose-700">
                        <i data-lucide="alert-circle" class="w-3.5 h-3.5 mr-1"></i> ค้างชำระ
                    </span>`;
                } else {
                    statusBadge = `<span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-semibold bg-amber-100 text-amber-800">
                        <i data-lucide="clock" class="w-3.5 h-3.5 mr-1"></i> ยังไม่จ่าย
                    </span>`;
                }

                let actionHtml = '';
                if (isTreasurer) {
                    actionHtml = `
                        <div class="flex items-center justify-center space-x-1.5">
                            <button onclick="toggleMemberStatus(${member.id})" class="px-2.5 py-1.5 rounded-lg border text-xs font-medium transition-all ${member.status === 'paid' ? 'bg-slate-100 text-slate-600 hover:bg-slate-200 border-slate-200' : 'bg-emerald-500 text-white hover:bg-emerald-600 border-emerald-600 shadow-sm'}" title="เปลี่ยนสถานะ">
                                ${member.status === 'paid' ? 'ยกเลิกจ่าย' : 'ทำการจ่ายแล้ว'}
                            </button>
                            <button onclick="openPromptPayModal(${member.amount})" class="p-1.5 text-emerald-600 hover:bg-emerald-50 rounded-lg" title="เปิด QR จ่ายเงิน">
                                <i data-lucide="qr-code" class="w-4 h-4"></i>
                            </button>
                            <button onclick="editMember(${member.id})" class="p-1.5 text-slate-400 hover:text-slate-700 hover:bg-slate-100 rounded-lg" title="แก้ไข">
                                <i data-lucide="edit-2" class="w-4 h-4"></i>
                            </button>
                            <button onclick="deleteMember(${member.id})" class="p-1.5 text-slate-400 hover:text-rose-600 hover:bg-rose-50 rounded-lg" title="ลบ">
                                <i data-lucide="trash-2" class="w-4 h-4"></i>
                            </button>
                        </div>
                    `;
                } else {
                    actionHtml = `
                        <div class="flex items-center justify-center space-x-1.5">
                            <button onclick="openPromptPayModal(${member.amount})" class="px-2.5 py-1.5 bg-slate-100 hover:bg-slate-200 text-slate-700 rounded-lg text-xs font-medium transition-all flex items-center space-x-1">
                                <i data-lucide="qr-code" class="w-3.5 h-3.5 text-emerald-600"></i>
                                <span>ดู QR โอนเงิน</span>
                            </button>
                        </div>
                    `;
                }

                tr.innerHTML = `
                    <td class="py-3 px-4 font-mono font-bold text-slate-500 text-center">${member.no}</td>
                    <td class="py-3 px-4 font-medium text-slate-900">
                        <div>${member.name}</div>
                        <div class="text-[10px] text-slate-400 font-mono">รหัส: ${member.stdId || '-'}</div>
                    </td>
                    <td class="py-3 px-4 text-center">${statusBadge}</td>
                    <td class="py-3 px-4 text-right font-semibold text-slate-800">฿${(member.amount || 100).toLocaleString('th-TH')}</td>
                    <td class="py-3 px-4 text-center">${actionHtml}</td>
                `;
                tbody.appendChild(tr);
            });
            lucide.createIcons();
        }

        function toggleMemberStatus(memberId) {
            const member = appState.members.find(m => m.id === memberId);
            if (member) {
                if (member.status === 'paid') {
                    member.status = 'pending';
                    showToast(`เปลี่ยนสถานะเป็น "ยังไม่จ่าย" สำหรับ ${member.name}`);
                } else {
                    member.status = 'paid';
                    showToast(`ตรวจสอบและยืนยันการโอนเงินเรียบร้อยสำหรับ ${member.name}`);
                }
                saveState();
            }
        }

        function setMemberFilter(filter) {
            currentFilter = filter;
            ['all', 'paid', 'pending', 'overdue'].forEach(f => {
                const btn = document.getElementById(`filterBtn${f.charAt(0).toUpperCase() + f.slice(1)}`);
                if (f === filter) {
                    btn.className = 'px-3 py-1.5 text-xs font-medium rounded-lg bg-slate-900 text-white transition-all whitespace-nowrap shadow-sm';
                } else {
                    btn.className = 'px-3 py-1.5 text-xs font-medium rounded-lg bg-slate-100 text-slate-600 hover:bg-slate-200 transition-all whitespace-nowrap';
                }
            });
            renderMembers();
        }

        function renderExpenses() {
            const container = document.getElementById('expenseList');
            const emptyState = document.getElementById('emptyExpenseState');
            container.innerHTML = '';

            if (appState.expenses.length === 0) {
                emptyState.classList.remove('hidden');
                return;
            } else {
                emptyState.classList.add('hidden');
            }

            const isTreasurer = currentUser && currentUser.role === 'treasurer';
            const sorted = [...appState.expenses].sort((a, b) => new Date(b.date) - new Date(a.date));

            sorted.forEach(item => {
                const div = document.createElement('div');
                div.className = 'p-4 flex items-center justify-between hover:bg-slate-50 transition-colors';

                div.innerHTML = `
                    <div class="flex items-start space-x-3">
                        <div class="w-10 h-10 rounded-xl bg-rose-50 text-rose-600 flex items-center justify-center font-bold flex-shrink-0 mt-0.5">
                            <i data-lucide="receipt" class="w-5 h-5"></i>
                        </div>
                        <div>
                            <h4 class="text-xs sm:text-sm font-semibold text-slate-900">${item.title}</h4>
                            <div class="flex items-center space-x-2 mt-1 text-[11px] text-slate-500">
                                <span class="px-2 py-0.5 bg-slate-100 text-slate-600 rounded-md font-medium">${item.category}</span>
                                <span>• ${item.date}</span>
                                ${item.note ? `<span>• ${item.note}</span>` : ''}
                            </div>
                        </div>
                    </div>
                    <div class="flex items-center space-x-3">
                        <div class="text-right">
                            <span class="text-sm sm:text-base font-bold text-rose-600">-฿${Number(item.amount).toLocaleString('th-TH', {minimumFractionDigits: 2})}</span>
                        </div>
                        ${isTreasurer ? `
                            <button onclick="deleteExpense(${item.id})" class="p-1.5 text-slate-400 hover:text-rose-600 hover:bg-rose-50 rounded-lg transition-colors">
                                <i data-lucide="trash-2" class="w-4 h-4"></i>
                            </button>
                        ` : ''}
                    </div>
                `;
                container.appendChild(div);
            });
            lucide.createIcons();
        }

        function handleSaveExpense(e) {
            e.preventDefault();
            const title = document.getElementById('expenseTitle').value;
            const amount = parseFloat(document.getElementById('expenseAmount').value);
            const category = document.getElementById('expenseCategory').value;
            const date = document.getElementById('expenseDate').value;
            const note = document.getElementById('expenseNote').value;

            appState.expenses.push({ id: Date.now(), title, amount, category, date, note });
            saveState();
            closeModal('modalExpense');
            showToast('ลงบิลรายจ่ายเรียบร้อยแล้ว');
            document.getElementById('expenseForm').reset();
        }

        function deleteExpense(id) {
            if (confirm('คุณต้องการลบรายการใช้จ่ายนี้ใช่หรือไม่?')) {
                appState.expenses = appState.expenses.filter(e => e.id !== id);
                saveState();
                showToast('ลบรายการใช้จ่ายเรียบร้อยแล้ว');
            }
        }

        function handleSaveMember(e) {
            e.preventDefault();
            const editId = document.getElementById('memberEditId').value;
            const no = document.getElementById('inputMemberNo').value.padStart(2, '0');
            const stdId = document.getElementById('inputMemberStdId').value.trim();
            const name = document.getElementById('inputMemberName').value.trim();
            const amount = parseFloat(document.getElementById('inputMemberAmount').value) || 100;
            const status = document.getElementById('inputMemberStatus').value;

            if (editId) {
                const member = appState.members.find(m => m.id == editId);
                if (member) {
                    member.no = no;
                    member.stdId = stdId;
                    member.name = name;
                    member.amount = amount;
                    member.status = status;
                }
                showToast('อัปเดตข้อมูลสมาชิกเรียบร้อยแล้ว');
            } else {
                appState.members.push({ id: Date.now(), no, stdId, name, amount, status });
                showToast('เพิ่มสมาชิกใหม่เรียบร้อยแล้ว');
            }

            saveState();
            closeModal('modalMember');
            document.getElementById('memberForm').reset();
        }

        function openAddMemberModal() {
            document.getElementById('memberEditId').value = '';
            document.getElementById('memberModalTitle').textContent = 'เพิ่มสมาชิกใหม่';
            document.getElementById('memberForm').reset();
            document.getElementById('inputMemberAmount').value = 100;
            openModal('modalMember');
        }

        function editMember(id) {
            const member = appState.members.find(m => m.id === id);
            if (member) {
                document.getElementById('memberEditId').value = member.id;
                document.getElementById('memberModalTitle').textContent = 'แก้ไขข้อมูลสมาชิก';
                document.getElementById('inputMemberNo').value = member.no;
                document.getElementById('inputMemberStdId').value = member.stdId || '';
                document.getElementById('inputMemberName').value = member.name;
                document.getElementById('inputMemberAmount').value = member.amount || 100;
                document.getElementById('inputMemberStatus').value = member.status;
                openModal('modalMember');
            }
        }

        function deleteMember(id) {
            if (confirm('คุณต้องการลบสมาชิกคนนี้ออกจากรายชื่อใช่หรือไม่?')) {
                appState.members = appState.members.filter(m => m.id !== id);
                saveState();
                showToast('ลบสมาชิกเรียบร้อยแล้ว');
            }
        }

        function openPromptPayModal(customAmount) {
            const amount = customAmount || 100;
            document.getElementById('qrAmountInput').value = amount;
            document.getElementById('modalPromptPayNo').textContent = formatPromptPay(appState.promptpayNo);
            document.getElementById('modalAccountName').textContent = appState.accountName;
            updateQrCodeModal();
            openModal('modalPromptPay');
        }

        function updateQrCodeModal() {
            const amount = parseFloat(document.getElementById('qrAmountInput').value) || 0;
            const payload = generatePromptPayPayload(appState.promptpayNo, amount);
            const qrContainer = document.getElementById('qrcodeCanvas');
            qrContainer.innerHTML = '';

            if (window.QRCode) {
                new QRCode(qrContainer, { text: payload, width: 170, height: 170, colorDark: "#0f172a", colorLight: "#ffffff", correctLevel: QRCode.CorrectLevel.M });
            } else {
                const img = document.createElement('img');
                img.src = `https://quickchart.io/qr?text=${encodeURIComponent(payload)}&size=170&margin=1`;
                img.alt = 'PromptPay QR';
                qrContainer.appendChild(img);
            }
        }

        function formatPromptPay(number) {
            const clean = number.replace(/[^0-9]/g, '');
            if (clean.length === 10) {
                return clean.replace(/(\d{3})(\d{3})(\d{4})/, '$1-$2-$3');
            }
            return clean;
        }

        function openLineModal() {
            const paidMembers = appState.members.filter(m => m.status === 'paid');
            const unpaidMembers = appState.members.filter(m => m.status !== 'paid');
            const totalPaidRevenue = paidMembers.reduce((sum, m) => sum + (m.amount || 100), 0);
            const totalExpenses = appState.expenses.reduce((sum, e) => sum + Number(e.amount), 0);
            const currentBalance = totalPaidRevenue - totalExpenses;

            let text = `📢 [สรุปยอดเงินกองกลาง ${appState.groupName}]\n`;
            text += `----------------------------------\n`;
            text += `💰 ยอดเก็บได้แล้ว: ฿${totalPaidRevenue.toLocaleString('th-TH')}\n`;
            text += `💸 ยอดใช้จ่ายแล้ว: ฿${totalExpenses.toLocaleString('th-TH')}\n`;
            text += `💵 ยอดคงเหลือปัจจุบัน: ฿${currentBalance.toLocaleString('th-TH')}\n`;
            text += `📊 สถานะ: จ่ายแล้ว ${paidMembers.length}/${appState.members.length} คน (${Math.round((paidMembers.length/appState.members.length)*100 || 0)}%)\n\n`;

            text += `⏳ รายชื่อคนที่ยังไม่จ่าย (${unpaidMembers.length} คน):\n`;
            if (unpaidMembers.length === 0) {
                text += `✅ ครบทุกคนแล้ว! ขอบคุณทุกคนมากครับ/ค่ะ 🎉\n`;
            } else {
                unpaidMembers.sort((a,b) => a.no.localeCompare(b.no, undefined, {numeric: true})).forEach(m => {
                    text += `• [เลขที่ ${m.no}] ${m.name} (฿${m.amount} บาท)\n`;
                });
            }

            text += `\n📱 ช่องทางโอนเงิน (พร้อมเปย์):\n`;
            text += `เลขบัญชี: ${formatPromptPay(appState.promptpayNo)}\n`;
            text += `ชื่อบัญชี: ${appState.accountName}\n`;
            text += `----------------------------------\n`;
            text += `*โอนเงินแล้วกรุณาส่งสลิปเข้ามาในไลน์กลุ่มได้เลยครับ/ค่ะ*`;

            document.getElementById('lineSummaryText').value = text;
            openModal('modalLine');
        }

        function copyLineSummary() {
            const text = document.getElementById('lineSummaryText').value;
            copyToClipboard(text, 'คัดลอกสรุปยอดเงินสำหรับส่ง LINE เรียบร้อยแล้ว!');
        }

        function openSettingsModal() {
            document.getElementById('setGroupName').value = appState.groupName;
            document.getElementById('setPromptPayNo').value = appState.promptpayNo;
            document.getElementById('setAccountName').value = appState.accountName;
            document.getElementById('setTargetGoal').value = appState.targetGoal || 1000;
            openModal('modalSettings');
        }

        function handleSaveSettings(e) {
            e.preventDefault();
            appState.groupName = document.getElementById('setGroupName').value;
            appState.promptpayNo = document.getElementById('setPromptPayNo').value;
            appState.accountName = document.getElementById('setAccountName').value;
            appState.targetGoal = parseFloat(document.getElementById('setTargetGoal').value) || 1000;

            saveState();
            closeModal('modalSettings');
            showToast('บันทึกการตั้งค่าเรียบร้อยแล้ว');
        }

        function switchTab(tab) {
            const sectionMembers = document.getElementById('sectionMembers');
            const sectionExpenses = document.getElementById('sectionExpenses');
            const btnMembers = document.getElementById('tabBtnMembers');
            const btnExpenses = document.getElementById('tabBtnExpenses');

            if (tab === 'members') {
                sectionMembers.classList.remove('hidden');
                sectionExpenses.classList.add('hidden');
                btnMembers.className = 'flex-1 py-2.5 px-4 text-xs sm:text-sm font-medium rounded-xl transition-all flex items-center justify-center space-x-2 bg-white text-slate-900 shadow-sm';
                btnExpenses.className = 'flex-1 py-2.5 px-4 text-xs sm:text-sm font-medium rounded-lg transition-all flex items-center justify-center space-x-2 text-slate-600 hover:text-slate-900';
            } else {
                sectionMembers.classList.add('hidden');
                sectionExpenses.classList.remove('hidden');
                btnExpenses.className = 'flex-1 py-2.5 px-4 text-xs sm:text-sm font-medium rounded-xl transition-all flex items-center justify-center space-x-2 bg-white text-slate-900 shadow-sm';
                btnMembers.className = 'flex-1 py-2.5 px-4 text-xs sm:text-sm font-medium rounded-lg transition-all flex items-center justify-center space-x-2 text-slate-600 hover:text-slate-900';
            }
        }

        function openModal(id) { document.getElementById(id).classList.remove('hidden'); }
        function closeModal(id) { document.getElementById(id).classList.add('hidden'); }

        function showToast(message) {
            const toast = document.getElementById('toast');
            document.getElementById('toastMessage').textContent = message;
            toast.classList.remove('translate-y-20', 'opacity-0');
            toast.classList.add('translate-y-0', 'opacity-100');

            setTimeout(() => {
                toast.classList.remove('translate-y-0', 'opacity-100');
                toast.classList.add('translate-y-20', 'opacity-0');
            }, 3000);
        }

        function copyToClipboard(text, toastMsg) {
            if (navigator.clipboard && window.isSecureContext) {
                navigator.clipboard.writeText(text).then(() => {
                    showToast(toastMsg || 'คัดลอกลง Clipboard เรียบร้อย');
                });
            } else {
                const textArea = document.createElement("textarea");
                textArea.value = text;
                textArea.style.position = "fixed";
                textArea.style.left = "-999999px";
                document.body.appendChild(textArea);
                textArea.focus();
                textArea.select();
                try {
                    document.execCommand('copy');
                    showToast(toastMsg || 'คัดลอกลง Clipboard เรียบร้อย');
                } catch (err) {
                    console.error('Copy failed', err);
                }
                document.body.removeChild(textArea);
            }
        }

        window.onload = function() {
            document.getElementById('expenseDate').valueAsDate = new Date();
            updateUI();
        };
    </script>
</body>
</html>
